/dts-v1/;

/*
 * Fiberhome HG6145F3: GPON ONT, 4x GbE, MT7916 Wi-Fi (DBDC) on PCIe0,
 * USB, EN7571 GPON optics behind an SFP-style cage (i2c via the LDD).
 * Airoha EN7523 (2x Cortex-A53), 1 GB DDR, 256 MiB SPI-NAND:
 *   0x000000-0x100000 u-boot (BL1 + FIP), 0x100000-0x10000000 UBI
 *   (ubootenv, ubootenv2, factory, bosa, fit).
 * Reconstructed from the DTB shipped in the prebuilt
 * openwrt-airoha-en7523-fiberhome_hg6145f3 FIT images.
 */

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "Fiberhome HG6145F3";
	compatible = "fiberhome,hg6145f3", "airoha,en7523";

	chosen {
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
		led-running = &led_power;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led@11 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&pinctrl 11 GPIO_ACTIVE_HIGH>;
		};

		led@4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <1>;
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
		};

		led@5 {
			label = "phone";
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
		};

		led@6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
		};

		led@27 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WPS;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi0 {
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x00000000 0x00100000>;
				read-only;
			};

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x00100000 0x0ff00000>;

				volumes {
					ubi-volume-ubootenv {
						volname = "ubootenv";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
							env-size = <0x4000>;
						};
					};

					ubi-volume-ubootenv2 {
						volname = "ubootenv2";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
							env-size = <0x4000>;

							/* env var "ethaddr", MAC base (+index) */
							ethaddr: ethaddr {
								#nvmem-cell-cells = <1>;
							};

							/* env var "asp_gpon_sn" */
							asp_gpon_sn: asp_gpon_sn {
								#nvmem-cell-cells = <1>;
							};
						};
					};

					ubi-volume-factory {
						volname = "factory";
						read-only;

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							/* MT7916 calibration EEPROM */
							eeprom: eeprom@0 {
								reg = <0x00000000 0x00033000>;
							};
						};
					};

					ubi-volume-bosa {
						volname = "bosa";
						read-only;

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							/* EN7571 BOB/laser calibration */
							en7571_bob: bob@0 {
								reg = <0x00000000 0x00000190>;
							};
						};
					};

					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,uimage";
					};
				};
			};
		};
	};
};

/*
 * The EN7523 pinctrl rejects the dtsi's open-drain setting on the PCIe
 * reset pins ("pin_config_set op failed for pin 41"), which stops both
 * PCIe controllers from probing. The reset works without it (same
 * workaround as en7523-skyworth_gn630v.dts).
 */
&pcie0 {
	status = "okay";

	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&pcie0_slot0 {
	mt7916@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		nvmem-cells = <&eeprom>;
		nvmem-cell-names = "eeprom";
		airoha,npu = <&npu>;
		airoha,eth = <&eth>;

		/* 2.4 GHz */
		band@0 {
			reg = <0>;
			nvmem-cells = <&ethaddr 1>;
			nvmem-cell-names = "mac-address";
		};

		/* 5 GHz */
		band@1 {
			reg = <1>;
			nvmem-cells = <&ethaddr 2>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&pcie1 {
	status = "okay";

	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&usb0 {
	status = "okay";
};

&npu {
	status = "okay";

	firmware-names = "rv32", "data";
	firmware-name = "airoha/en7523_kite_npu_rv32.bin",
			"airoha/en7523_kite_npu_data.bin";
};

&i2c0 {
	status = "okay";

	en7571: lddla@70 {
		compatible = "airoha,en7571";
		reg = <0x70>;

		nvmem-cells = <&en7571_bob>;
		nvmem-cell-names = "calibration";

		#optical-frontend-cells = <0>;
	};
};

&xpon_phy {
	status = "okay";

	/* not wired on this board (the shipped DTB has no tx-disable) */
	/delete-property/ tx-disable-gpios;
};

&xpon {
	status = "okay";

	nvmem-cells = <&asp_gpon_sn>;
	nvmem-cell-names = "gpon-serial-number";
	airoha,gpon-serial-from-mac;
	omci-vendor-id = "HWTC";

	optical-frontends = <&en7571>;
	optical-frontend-names = "pon";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";

	nvmem-cells = <&ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&gdm2_pon {
	status = "okay";

	nvmem-cells = <&ethaddr 0>;
	nvmem-cell-names = "mac-address";

	openwrt,netdev-name = "pon0";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_port6 {
	nvmem-cells = <&ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy1_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy1_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy4_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};
