#!/bin/sh
# libuci deletes empty strings. Schema 2 therefore distinguishes a deliberate
# PLOAM clear from a pre-split installation, including future package upgrades.
[ "$(uci -q get xg140g-pon.onu.credential_schema)" = 2 ] && exit 0
if ! uci -q get xg140g-pon.onu.ploam_password >/dev/null; then
    old=$(uci -q get xg140g-pon.onu.password)
    [ -n "$old" ] || old=$(uci -q get xg140g-pon.onu.gpon_pw)
    uci set "xg140g-pon.onu.ploam_password=$old" || exit 1
    uci set "xg140g-pon.onu.password=$old" || exit 1
fi
uci set xg140g-pon.onu.credential_schema=2 || exit 1
uci commit xg140g-pon || exit 1
exit 0
