#!/bin/sh
# Enable the common NPU/PPE path on fresh installations. No PON carrier,
# management session or WAN route is required for non-PON hardware flows.
# The kernel admits PON flows only when their own dataplane is ready.

set -eu

# This file runs again after sysupgrade. Preserve any existing user choice;
# only a fresh firewall configuration with neither flag gets our defaults.
if uci -q get firewall.@defaults[0].flow_offloading >/dev/null 2>&1 ||
   uci -q get firewall.@defaults[0].flow_offloading_hw >/dev/null 2>&1; then
	exit 0
fi
uci -q set firewall.@defaults[0].flow_offloading=1
uci -q set firewall.@defaults[0].flow_offloading_hw=1
uci commit firewall

exit 0
