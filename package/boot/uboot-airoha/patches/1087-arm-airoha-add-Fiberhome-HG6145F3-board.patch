From 1308e03927f19f9871675d3703006a47c2abb450 Mon Sep 17 00:00:00 2001
From: yoggedebaqi <sammi360@gmail.com>
Date: Sat, 21 Nov 2026 08:29:07 +0800
Subject: [PATCH] arm: airoha: add Fiberhome HG6145F3 board

Add the defconfig, default environment and device tree for the
Fiberhome HG6145F3 GPON ONT (EN7523). Environment recovered from
the prebuilt openwrt-airoha-en7523-fiberhome_hg6145f3 u-boot:
UBI env in ubootenv/ubootenv2, boot from the fit UBI volume with
TFTP fallback plus menu entries for factory/bosa calibration and
u-boot upgrade.
---
 configs/en7523-fiberhome_hg6145f3_defconfig   | 88 +++++++++++++++++++
 defenvs/en7523-fiberhome_hg6145f3_env         | 46 ++++++++++
 .../arm/airoha/en7523-fiberhome_hg6145f3.dts  | 87 ++++++++++++++++++
 3 files changed, 221 insertions(+)
 create mode 100644 configs/en7523-fiberhome_hg6145f3_defconfig
 create mode 100644 defenvs/en7523-fiberhome_hg6145f3_env
 create mode 100644 dts/upstream/src/arm/airoha/en7523-fiberhome_hg6145f3.dts

diff --git a/configs/en7523-fiberhome_hg6145f3_defconfig b/configs/en7523-fiberhome_hg6145f3_defconfig
new file mode 100644
index 00000000..a5f1fe44
--- /dev/null
+++ b/configs/en7523-fiberhome_hg6145f3_defconfig
@@ -0,0 +1,88 @@
+CONFIG_ARM=y
+CONFIG_POSITION_INDEPENDENT=y
+CONFIG_GIC_V3_ITS=y
+CONFIG_SYS_ARCH_TIMER=y
+CONFIG_ARCH_AIROHA=y
+CONFIG_TEXT_BASE=0x81E00000
+CONFIG_SYS_MALLOC_F_LEN=0x4000
+CONFIG_NR_DRAM_BANKS=1
+CONFIG_ENV_SIZE=0x4000
+CONFIG_DM_GPIO=y
+CONFIG_DEFAULT_DEVICE_TREE="airoha/en7523-fiberhome_hg6145f3"
+CONFIG_SYS_BOOTM_LEN=0x04600000
+CONFIG_SYS_LOAD_ADDR=0x81800000
+CONFIG_BUILD_TARGET="u-boot.bin"
+CONFIG_FIT=y
+CONFIG_FIT_VERBOSE=y
+CONFIG_BOOTDELAY=3
+CONFIG_DEFAULT_FDT_FILE="en7523-fiberhome_hg6145f3"
+CONFIG_SYS_PBSIZE=1049
+CONFIG_SYS_CONSOLE_IS_IN_ENV=y
+CONFIG_HUSH_PARSER=y
+CONFIG_SYS_PROMPT="U-Boot> "
+CONFIG_SYS_MAXARGS=8
+CONFIG_CMD_BOOTZ=y
+CONFIG_CMD_BOOTMENU=y
+# CONFIG_CMD_ELF is not set
+# CONFIG_CMD_XIMG is not set
+CONFIG_CMD_BIND=y
+CONFIG_CMD_BIN2MAC=y
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_MTD=y
+CONFIG_CMD_PART=y
+# CONFIG_CMD_SETEXPR is not set
+CONFIG_CMD_TFTPPUT=y
+CONFIG_CMD_PING=y
+CONFIG_CMD_EXT4=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_CMD_MTDPARTS=y
+CONFIG_CMD_LOG=y
+CONFIG_CMD_UBI=y
+CONFIG_OF_UPSTREAM=y
+CONFIG_ENV_OVERWRITE=y
+# CONFIG_ENV_IS_IN_MTD is not set
+CONFIG_ENV_IS_IN_UBI=y
+CONFIG_ENV_REDUNDANT=y
+CONFIG_ENV_UBI_PART="ubi"
+CONFIG_ENV_UBI_VOLUME="ubootenv"
+CONFIG_ENV_UBI_VOLUME_REDUND="ubootenv2"
+CONFIG_ENV_RELOC_GD_ENV_ADDR=y
+CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
+CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="defenvs/en7523-fiberhome_hg6145f3_env"
+CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
+CONFIG_IPV6=y
+CONFIG_NET_RANDOM_ETHADDR=y
+CONFIG_SYS_RX_ETH_BUFFER=8
+CONFIG_REGMAP=y
+CONFIG_BUTTON=y
+CONFIG_BUTTON_GPIO=y
+CONFIG_CLK=y
+CONFIG_DMA=y
+CONFIG_SYS_I2C_MT7621=y
+CONFIG_LED=y
+CONFIG_LED_BOOT=y
+CONFIG_LED_BLINK=y
+CONFIG_LED_SW_BLINK=y
+CONFIG_LED_GPIO=y
+# CONFIG_MMC is not set
+CONFIG_MTD=y
+CONFIG_DM_MTD=y
+CONFIG_MTD_SPI_NAND=y
+CONFIG_UBI_BLOCK=y
+CONFIG_DM_MDIO=y
+CONFIG_AIROHA_ETH=y
+CONFIG_PHY=y
+CONFIG_PINCTRL=y
+CONFIG_PINCTRL_AIROHA_EN7523=y
+CONFIG_RAM=y
+CONFIG_DM_SERIAL=y
+CONFIG_SYS_NS16550=y
+CONFIG_SPI=y
+CONFIG_DM_SPI=y
+CONFIG_AIROHA_SNFI_SPI=y
+# CONFIG_UBIFS_SILENCE_MSG is not set
+CONFIG_FS_SQUASHFS=y
+CONFIG_SHA512=y
+CONFIG_LZMA=y
+# CONFIG_VPL_LZMA is not set
diff --git a/defenvs/en7523-fiberhome_hg6145f3_env b/defenvs/en7523-fiberhome_hg6145f3_env
new file mode 100644
index 00000000..270ba4c1
--- /dev/null
+++ b/defenvs/en7523-fiberhome_hg6145f3_env
@@ -0,0 +1,46 @@
+loadaddr=0x89400000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootled_pwr=green:power
+
+bootconf=config-1
+bootfile=openwrt-airoha-en7523-fiberhome_hg6145f3-initramfs-kernel.bin
+bootloaderfile=openwrt-airoha-en7523-fiberhome_hg6145f3-uboot-bootloader.bin
+bootfile_factory=openwrt-airoha-en7523-fiberhome_hg6145f3-factory.bin
+bootfile_bosa=openwrt-airoha-en7523-fiberhome_hg6145f3-bosa.bin
+
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
+
+boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr on ; echo Install openwrt ; run boot_tftp
+boot_ubi=ubi part ubi && run boot_openwrt
+
+upgrade_uboot=\
+  mw.b 0x89800000 0xff 0x100000 && tftpboot 0x89800000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x89800000
+
+format_ubi_part=\
+  mtd erase ubi && ubi part ubi && \
+  ubi create ubootenv 0x40000 && ubi create ubootenv2 0x40000 && \
+  ubi create factory 0x100000 dynamic && ubi create bosa 0x100000 dynamic && \
+  saveenv && saveenv
+
+boot_tftp_write_factory=tftpboot $loadaddr $bootfile_factory && run ubi_write_factory
+boot_tftp_write_bosa=tftpboot $loadaddr $bootfile_bosa && run ubi_write_bosa
+ubi_write_factory=ubi part ubi ; ubi check factory && ubi remove factory ; ubi create factory 0x100000 dynamic && ubi write $loadaddr factory $filesize
+ubi_write_bosa=ubi part ubi ; ubi check bosa && ubi remove bosa ; ubi create bosa 0x100000 dynamic && ubi write $loadaddr bosa $filesize
+ubi_format=ubi detach ; mtd erase ubi && ubi part ubi
+
+bootcmd=run boot_ubi
+bootdelay=3
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=( ( ( OpenWrt ) ) )
+bootmenu_0=Run default boot command.=run boot_openwrt
+bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Format UBI partition.=ubi info ubi && echo not require format again || run format_ubi_part
+bootmenu_3=Write WiFi calibration (factory volume).=run boot_tftp_write_factory ; run bootmenu_confirm_return
+bootmenu_4=Write BOSA optical calibration (bosa volume).=run boot_tftp_write_bosa ; run bootmenu_confirm_return
+bootmenu_5=Upgrade u-boot.=run upgrade_uboot
+bootmenu_6=Reboot.=reset
diff --git a/dts/upstream/src/arm/airoha/en7523-fiberhome_hg6145f3.dts b/dts/upstream/src/arm/airoha/en7523-fiberhome_hg6145f3.dts
new file mode 100644
index 00000000..84045c4e
--- /dev/null
+++ b/dts/upstream/src/arm/airoha/en7523-fiberhome_hg6145f3.dts
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/* Bootloader installs ATF here */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "Fiberhome HG6145F3";
+	compatible = "fiberhome,hg6145f3", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	/* 512 MiB declared here; U-Boot fixes the range up to the
+	 * detected DRAM size (1 GiB) before handing off to the kernel.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/* power LED is wired active-high on this board */
+		led@11 {
+			label = "green:power";
+			gpios = <&pinctrl 11 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+};
+
+&snfi {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "u-boot";
+			reg = <0x000000 0x100000>;
+		};
+
+		partition@100000 {
+			label = "ubi";
+			compatible = "linux,ubi";
+			reg = <0x100000 0x10000000>;
+		};
+	};
+};
-- 
2.55.0

